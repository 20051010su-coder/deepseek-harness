{
  "name": "dsh-desktop-community",
  "version": "0.1.6",
  "description": "Unofficial community desktop wrapper for DeepSeek Harness",
  "main": "desktop/main.cjs",
  "author": "DSH Desktop Community contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "test:smoke": "node desktop/smoke-test.cjs",
    "test:runtime": "node desktop/runtime-server-test.cjs --entry runtime/node_modules/@deepseek-ai/dsh/lib/bin.js"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "39.2.7",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "community.dsh.desktop",
    "productName": "DSH Desktop Community",
    "artifactName": "DSH-Desktop-Community-${version}-${arch}.${ext}",
    "asar": false,
    "files": [
      "desktop/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime/node_modules",
        "to": "runtime/node_modules",
        "filter": ["**/*"]
      },
      {
        "from": "runtime/package.json",
        "to": "runtime/package.json"
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH Desktop Community",
      "uninstallDisplayName": "DSH Desktop Community",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
